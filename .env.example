# Credentials for the three pre-created, long-lived test accounts (one per
# account type). Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is git-ignored, so real credentials never get committed. auth.setup.ts
# logs into each account once and saves its session under .auth/; every test
# then reuses that session (assignment 4.3, "created once and reused").

PERSONAL_EMAIL=
PERSONAL_PASSWORD=

BUSINESS_EMAIL=
BUSINESS_PASSWORD=

CLIENTS_EMAIL=
CLIENTS_PASSWORD=

# An address that was signed up and then permanently deleted. TC-SU-07 asserts
# the form refuses to sign it up again. It is a real inbox, so it lives here
# rather than in the repo.
DELETED_ACCOUNT_EMAIL=
